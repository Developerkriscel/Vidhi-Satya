# Optional Cloudinary (leave blank if using local uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (Resend)
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Vidhi Satya <noreply@vidhisatya.com>
NOTIFICATION_EMAIL=rajeshnarang@vidhisatya.com
